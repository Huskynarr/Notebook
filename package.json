{
  "name": "notebook",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huskynarr/Notebook.git"
  },
  "author": "Sebastian Selinger",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare": "pnpm --filter @notebook/shared build",
    "build:shared": "pnpm --filter @notebook/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "theme": "python3 tools/build-theme.py && prettier --write apps/web/src/styles/theme.css --log-level warn",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm build:shared && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:shared && vitest run",
    "test:watch": "pnpm build:shared && vitest",
    "test:e2e": "pnpm build:shared && pnpm --filter @notebook/web build && playwright test",
    "verify": "pnpm theme && pnpm build:shared && pnpm -r typecheck && eslint . --max-warnings=0 && prettier --check . && vitest run && pnpm --filter @notebook/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.50.0"
  }
}
