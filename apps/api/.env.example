# Backend-Konfiguration. Kopieren nach apps/api/.env
# Nichts hiervon erreicht jemals das Frontend (AGENTS.md Regel 4).

NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# Leer: keine Forwarded-Header vertrauen. In Plesk nur lokale Proxy-IP erlauben.
TRUST_PROXY=
CORS_ORIGIN=http://localhost:5173

DATABASE_PATH=./data/notebook.db

# Einfacher Zugang (D-003). Vor einem Betrieb ausserhalb von localhost aendern.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Ohne Vorgabe wird beim Start ein zufaelliges Geheimnis erzeugt;
# Sitzungen gelten dann nur bis zum Neustart.
# Produktion: eigenes Passwort >=16 Zeichen, AUTH_SECRET >=32 Zeichen zwingend.
# AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12

# stub   = kein Modell verbunden, Antworten sind sichtbar als simuliert markiert
# openai = echter, OpenAI-kompatibler Endpunkt (vLLM, Ollama, LiteLLM, Azure, OpenAI)
LLM_PROVIDER=stub
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:14b-instruct
LLM_TIMEOUT_MS=120000
LLM_TEMPERATURE=0

RETRIEVAL_TOP_K=12
CHUNK_TARGET_CHARS=1200

SEED_ON_EMPTY=true

# NVIDIA-Testprofil und Anbietergrenzen: docs/providers.md
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
